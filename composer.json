{
    "name": "zana/filesystem",
    "description": "Filesystem abstraction for Zana applications",
    "type": "library",
    "keywords": ["zana", "filesystem", "file", "storage"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Filesystem\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

