{
    "name": "mj-zana/filesystem",
    "description": "Storage disks (local, memory) with path safety and upload storage for Zana applications",
    "type": "library",
    "keywords": ["zana", "filesystem", "storage", "uploads"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-fileinfo": "Detects MIME types from file contents"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Filesystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Filesystem\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
